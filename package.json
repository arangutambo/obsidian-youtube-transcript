{
	"name": "obsidian-youtube-transcript",
	"version": "0.1.0",
	"description": "Read a YouTube transcript out of the page itself, from inside Obsidian desktop, using trusted Electron input.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist", "src", "README.md", "LICENSE"],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -noEmit"
	},
	"keywords": ["obsidian", "youtube", "transcript", "captions", "electron", "webview"],
	"author": "Antoine Haddad",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arangutambo/obsidian-youtube-transcript.git"
	},
	"devDependencies": {
		"@types/node": "^20.12.7",
		"typescript": "^5.4.5",
		"vitest": "^3.2.7"
	}
}
